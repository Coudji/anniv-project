# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Base SQLite : en production, un chemin hors de build/ (ex : /home/ubuntu/aniki-data/db.sqlite3)
# DB_FILE=

# Binaire SQLite compilé sur le serveur, si celui du paquet ne se charge pas (glibc trop ancienne)
# SQLITE_BINDING=

# Mode triche : /triche/<code> l'active, /triche/off le désactive
TRICHE_CODE=
